# ── 접근 코드 게이트 (브라우저 + 서버 공용). 비어 있으면 누구나 들어오고 서버도 검사하지 않는다.
# 값 만들기: pnpm access:hash <코드>   (실제 값은 .env.local 에만 두고 커밋하지 않는다)
VITE_ACCESS_CODE_HASH=

# ── 읽기·번역 엔진 선택 (브라우저). remote = /api/extract 호출, mock = 브라우저 안 샘플.
# 비어 있으면 배포 빌드는 remote, pnpm dev 는 mock.
VITE_EXTRACTOR=

# ── 서버 함수 (api/). 로컬에서는 pnpm dev 가 .env.local 을 같이 읽는다.
# 엔진 이름. 모델을 정하면 api/_lib/engines/ 에 추가하고 여기서 고른다.
EXTRACT_ENGINE=sample
# IP 하나당 하루 호출 한도
DAILY_LIMIT_PER_IP=20
